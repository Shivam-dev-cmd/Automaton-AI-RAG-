# ========================================================
# Automaton AI Chatbot - Environment Configuration
# ========================================================

# Server Settings
PORT=8000
HOST=127.0.0.1
DEBUG=False

# LLM Provider Configuration
# Supported providers:
# - "deterministic" (Built-in offline zero-hallucination grounded engine, no API key needed)
# - "gemini" (Google Gemini API: gemini-1.5-flash / gemini-2.5-flash)
# - "openai" (OpenAI API / Groq / Ollama / any OpenAI compatible endpoint)
LLM_PROVIDER=deterministic

# Optional: Google Gemini API Key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI / Groq / Ollama API Settings
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Guardrail & Retrieval Settings
STRICT_GUARDRAILS=True
CONFIDENCE_THRESHOLD=0.35
MAX_RETRIEVED_CHUNKS=4
